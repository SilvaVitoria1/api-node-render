# Copie para .env (local) ou cadastre em Render > Environment.
# NUNCA faca commit do .env com valores reais.

# Login do SSO da ANAC (o mesmo que voce usa pra entrar no SACI)
SACI_USER=seu.usuario
SACI_PASS=sua-senha

# Chave que a planilha manda no header x-api-key. Invente uma string longa.
API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Opcionais (ja tem padrao no codigo)
# SACI_URL=https://saci.anac.gov.br/SACI/CIV/inclusao/inclusao.asp?idMdl=447-4963
# SACI_EMPRESA=993
# LOGIN_BOTAO=Entrar como externo
# SESSION_TTL_MS=1200000
# BROWSER_IDLE_MS=300000
# NAV_TIMEOUT_MS=60000
# HEADLESS=true
